# Path to the SQLite file. Use an absolute path on durable storage in production.
DATABASE_PATH=./local.db

# Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Public base URL
APP_URL=http://localhost:5173

# Google service account (base64-encoded JSON key, never in git)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Set to 1 to read calendar fixtures instead of Google
FAKE_CALENDAR=0

# Seeded staff account (development only)
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change-me-too
