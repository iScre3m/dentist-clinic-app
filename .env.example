# Path to the SQLite file. Use an absolute path on durable storage in production.
DATABASE_PATH=./local.db

# Auth (JWT-based)
AUTH_SECRET=change-me-32-characters-minimum-secret
AUTH_USERNAME=staff@example.com
AUTH_PASSWORD_HASH=$2b$10$abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLM

# Public base URL
APP_URL=http://localhost:5173

# Google service account (base64-encoded JSON key, never in git)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Set to 1 to read calendar fixtures instead of Google
FAKE_CALENDAR=0

# Nylas calendar (sandbox testing). API key and grant id, never in git.
NYLAS_API_KEY=
NYLAS_GRANT_ID=
# Practice calendar inside the grant; "primary" is the default.
NYLAS_CALENDAR_ID=primary

# Clinic identity shown on invoices
CLINIC_NAME=Consultorio Dra. Laura
CLINIC_PHONE=+54 9 11 5555 5555
CLINIC_ADDRESS=Calle Falsa 123, CABA

# Seeded staff account (development only)
SEED_STAFF_NAME=Dra. Laura
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change-me-too

# Cloudflare operations only (never in git): remote D1 migrations and deploy.
# Read by wrangler; not used by the app itself.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
