# Path to the SQLite file. Use an absolute path on durable storage in production.
DATABASE_PATH=./local.db

# Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Public base URL
APP_URL=http://localhost:5173

# Google service account (base64-encoded JSON key, never in git)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Set to 1 to read calendar fixtures instead of Google
FAKE_CALENDAR=0

# Seeded staff accounts (development only)
SEED_DENTIST_EMAIL=dentist@example.com
SEED_DENTIST_PASSWORD=change-me-too
SEED_ASSISTANT_EMAIL=assistant@example.com
SEED_ASSISTANT_PASSWORD=change-me-too
