# syntax=docker/dockerfile:1

# Pin pnpm so the image matches the pnpm that wrote pnpm-lock.yaml.
# Keep this in sync when upgrading pnpm locally.
ARG PNPM_VERSION=12.16.1

FROM node:22-slim
ARG PNPM_VERSION

# Install pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Install build dependencies for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files. pnpm-workspace.yaml holds the allowBuilds list that lets
# esbuild and better-sqlite3 run their install scripts.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY . .

# Create data directory for SQLite. It lives outside /app so Vite does not
# watch the database file and reload the page on every write.
RUN mkdir -p /data

EXPOSE 5173

ENV NODE_ENV=development
ENV PORT=5173
ENV HOST=0.0.0.0

# Start dev server
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173"]
